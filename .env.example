# Пустые токен и chat id оставляют dry-run: текст печатается в консоль.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Коридор ask. Выше 0.97 почти нет выплаты, около 0.999 рынок уже фактически решён.
MIN_OUTCOME_PRICE=0.90
MAX_OUTCOME_PRICE=0.97
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_24H_USD=5000
MAX_SPREAD=0.03
MIN_HOURS_TO_RESOLUTION=2
MAX_DAYS_TO_RESOLUTION=14

# Не повторять тот же исход 12 часов, если ask не сдвинулся минимум на 0.03.
DEDUPE_HOURS=12
PRICE_MOVE_REALERT=0.03
POLL_INTERVAL_SECONDS=300

GAMMA_PAGE_LIMIT=100
GAMMA_MAX_MARKETS=500
MAX_CLOB_LOOKUPS=40
STATE_PATH=.alert-state.json
