# Скопируйте в .env и заполните. Файл .env не коммитится.

# https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Строка StringSession из `python -m newsbot.login`.
# Пусто — файловая сессия рядом с базой (data/newsbot.session).
TELEGRAM_SESSION=

# @BotFather → /newbot. Бот должен быть админом целевого канала.
BOT_TOKEN=

# OpenAI-совместимый chat API. Если OPENAI_API_KEY пустой,
# рерайт пропускается: пост всё равно чистится и публикуется.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=

CONFIG_PATH=config.yaml
DATABASE_PATH=data/newsbot.sqlite
