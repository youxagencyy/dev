# Local Postgres. The public homepage renders from RSS without this.
# The reader cabinet (sign-in, bookmarks, history, settings) requires it.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/varta?schema=public"
AUTH_SECRET="replace-with-a-long-random-string"
# Optional. Set this in production to the public site origin.
# Leave it unset locally so sign-in stays on the host you opened.
# Optional, only for `npm run admin:seed`. Do not commit the password.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
