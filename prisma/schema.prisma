generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  READER
  ADMIN
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  DELETED
}

enum ArticleCategory {
  UKRAINA
  VIINA
  POLITYKA
  SVIT
}

/// Auth.js / NextAuth user. Role is reader or admin.
model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  role             Role              @default(READER)
  passwordHash     String?
  theme            Theme             @default(SYSTEM)
  /// Categories included in this reader's personal feed.
  feedCategories   ArticleCategory[] @default([UKRAINA, VIINA, POLITYKA, SVIT])
  accounts         Account[]
  sessions         Session[]
  folders          Folder[]
  bookmarks        Bookmark[]
  reads            ReadEvent[]
  notificationPref NotificationPref?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Source {
  id        String          @id @default(cuid())
  name      String
  feedUrl   String          @unique
  homepage  String?
  active    Boolean         @default(true)
  /// Used only when the headline has no stronger section signal.
  fallback  ArticleCategory @default(UKRAINA)
  articles  Article[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Article {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  rewrittenBody  String          @default("") @db.Text
  /// Up to three short bullets. Empty until a rewrite is stored.
  summaryBullets String[]
  tags           String[]
  coverUrl       String?
  category       ArticleCategory
  status         ArticleStatus   @default(DRAFT)
  outletName     String
  publishedAt    DateTime?
  sourceId       String?
  source         Source?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  bookmarks      Bookmark[]
  reads          ReadEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([category, publishedAt])
  @@index([sourceId])
}

model Folder {
  id        String     @id @default(cuid())
  userId    String
  name      String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  folderId  String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  folder    Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@unique([userId, articleId])
  @@index([userId, folderId])
}

model ReadEvent {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  progress  Float    @default(0)
  readAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([articleId])
}

model NotificationPref {
  id           String            @id @default(cuid())
  userId       String            @unique
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaking     Boolean           @default(true)
  dailyBrief   Boolean           @default(true)
  emailEnabled Boolean           @default(false)
  categories   ArticleCategory[]
  updatedAt    DateTime          @updatedAt
}
